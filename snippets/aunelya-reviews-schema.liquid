{% doc %}
  Renders Product + AggregateRating + Review JSON-LD from curated review blocks.

  TEMPORARY: only renders while no review app writes the standard
  product.metafields.reviews.rating / rating_count metafields. Remove this
  render once a compatible review app (Judge.me, Loox…) is installed, as the
  native {{ product | structured_data }} will then include aggregateRating.

  @param {array} blocks - Section blocks (review type).
  @param {object} product - Current product.
{% enddoc %}

{% liquid
  assign app_count = product.metafields.reviews.rating_count.value | default: 0
  assign manual_count = 0
  assign manual_total = 0
  for block in blocks
    if block.type == 'review' and block.settings.text != blank and block.settings.author != blank
      assign manual_count = manual_count | plus: 1
      assign manual_total = manual_total | plus: block.settings.rating
    endif
  endfor
%}

{% if app_count == 0 and manual_count > 0 %}
  {% liquid
    assign avg = manual_total | times: 1.0 | divided_by: manual_count | round: 1
    assign product_url = shop.url | append: product.url
    assign reviews_json = ''
    for block in blocks
      if block.type == 'review' and block.settings.text != blank and block.settings.author != blank
        assign author_name = block.settings.author | strip | json
        assign body = block.settings.text | strip_html | strip | truncate: 500 | json
        assign rating_json = '{"@type":"Rating","ratingValue":' | append: block.settings.rating | append: ',"bestRating":5}'

        # Map "15 SEP 2026" -> "2026-09-15" for datePublished.
        assign date_iso = ''
        assign date_parts = block.settings.date | strip | split: ' '
        if date_parts.size == 3
          assign day = date_parts[0]
          if day.size == 1
            assign day = '0' | append: day
          endif
          assign mon = '01'
          case date_parts[1]
            when 'ENE'
              assign mon = '01'
            when 'FEB'
              assign mon = '02'
            when 'MAR'
              assign mon = '03'
            when 'ABR'
              assign mon = '04'
            when 'MAY'
              assign mon = '05'
            when 'JUN'
              assign mon = '06'
            when 'JUL'
              assign mon = '07'
            when 'AGO'
              assign mon = '08'
            when 'SEP'
              assign mon = '09'
            when 'OCT'
              assign mon = '10'
            when 'NOV'
              assign mon = '11'
            when 'DIC'
              assign mon = '12'
          endcase
          assign date_iso = date_parts[2] | append: '-' | append: mon | append: '-' | append: day
        endif

        assign item = '{"@type":"Review","author":{"@type":"Person","name":' | append: author_name | append: '},"reviewRating":' | append: rating_json | append: ',"reviewBody":' | append: body
        if date_iso != ''
          assign item = item | append: ',"datePublished":"' | append: date_iso | append: '"'
        endif
        assign item = item | append: '}'
        if reviews_json == ''
          assign reviews_json = item
        else
          assign reviews_json = reviews_json | append: ',' | append: item
        endif
      endif
    endfor
  %}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"Product","@id":{{ product_url | json }},"name":{{ product.title | json }},"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ avg }},"reviewCount":{{ manual_count }}},"review":[{{ reviews_json }}]}
  </script>
{% endif %}
