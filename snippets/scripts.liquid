{% doc %}
  Renders all global scripts, module preloads, and importmaps for the theme.

  @param {object} [product] - The product object, available on product pages.
{% enddoc %}

<script type="importmap">
  {
    "imports": {
      "@theme/overflow-list": "{{ 'overflow-list.js' | asset_url }}",
      "@theme/component": "{{ 'component.js' | asset_url }}",
      "@theme/dialog": "{{ 'dialog.js' | asset_url }}",
      "@theme/events": "{{ 'events.js' | asset_url }}",
      "@shopify/events": "https://cdn.shopify.com/storefront/standard-events.js",
      "@theme/view-event-elements": "{{ 'view-event-elements.js' | asset_url }}",
      "@theme/focus": "{{ 'focus.js' | asset_url }}",
      "@theme/morph": "{{ 'morph.js' | asset_url }}",
      "@theme/paginated-list": "{{ 'paginated-list.js' | asset_url }}",
      "@theme/performance": "{{ 'performance.js' | asset_url }}",
      "@theme/product-form": "{{ 'product-form.js' | asset_url }}",
      "@theme/recently-viewed-products": "{{ 'recently-viewed-products.js' | asset_url }}",
      "@theme/scrolling": "{{ 'scrolling.js' | asset_url }}",
      "@theme/section-renderer": "{{ 'section-renderer.js' | asset_url }}",
      "@theme/section-hydration": "{{ 'section-hydration.js' | asset_url }}",
      "@theme/money-formatting": "{{ 'money-formatting.js' | asset_url }}",
      "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
      "@theme/variant-picker": "{{ 'variant-picker.js' | asset_url }}",
      "@theme/variant-resolution": "{{ 'variant-resolution.js' | asset_url }}",
      "@theme/media-gallery": "{{ 'media-gallery.js' | asset_url }}",
      "@theme/quick-add": "{{ 'quick-add.js' | asset_url }}",
      "@theme/paginated-list-aspect-ratio": "{{ 'paginated-list-aspect-ratio.js' | asset_url }}",
      "@theme/component-quantity-selector": "{{ 'component-quantity-selector.js' | asset_url }}",
      "@theme/comparison-slider": "{{ 'comparison-slider.js' | asset_url }}",
      "@theme/sticky-add-to-cart": "{{ 'sticky-add-to-cart.js' | asset_url }}",
      "@theme/fly-to-cart": "{{ 'fly-to-cart.js' | asset_url }}",
      "@theme/scroll-container": "{{ 'scroll-container.js' | asset_url }}",
      "@theme/theme-drawer": "{{ 'theme-drawer.js' | asset_url }}"
    }
  }
</script>

{%- comment -%}
  Registers Horizon's cart-drawer behaviour against the standard-actions
  bundle (loaded separately into <head>). Module scripts execute in
  document order, so this runs after the bundle regardless of where it
  lands in <head>.
{%- endcomment -%}
<script
  src="{{ 'standard-actions-override.js' | asset_url }}"
  type="module"
></script>

<script
  src="{{ 'page-view-event.js' | asset_url }}"
  type="module"
  defer
></script>

{% if settings.transition_to_main_product or settings.page_transition_enabled %}
  {%- comment -%}
    Inlined to avoid a network round trip for a render blocking asset.
  {%- endcomment -%}
  <script>
    {{- 'view-transitions.js' | inline_asset_content -}}
  </script>
{% endif %}

<link
  rel="modulepreload"
  href="{{ 'utilities.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'component.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'section-renderer.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'section-hydration.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'morph.js' | asset_url }}"
  fetchpriority="low"
>

{% if template.name == 'collection' or template.name == 'search' %}
  <link
    rel="modulepreload"
    href="{{ 'paginated-list-aspect-ratio.js' | asset_url }}"
    fetchpriority="low"
  >
  <link
    rel="modulepreload"
    href="{{ 'paginated-list.js' | asset_url }}"
    fetchpriority="low"
  >
{% endif %}

<link
  rel="modulepreload"
  href="{{ 'focus.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'recently-viewed-products.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'scrolling.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'events.js' | asset_url }}"
  fetchpriority="low"
>
{%- liquid
  # Fase 2 rendimiento (docs/SEO.md M5): divide los modulos por tipo de pagina.
  # En el editor se cargan todos para no romper la previsualizacion.
  assign aunelya_is_product = false
  if request.page_type == 'product' or request.design_mode
    assign aunelya_is_product = true
  endif
  assign aunelya_is_cart = false
  if request.page_type == 'cart' or request.page_type == 'page' or request.design_mode
    assign aunelya_is_cart = true
  endif
  assign aunelya_is_collection_search = false
  if request.page_type == 'collection' or request.page_type == 'search' or request.design_mode
    assign aunelya_is_collection_search = true
  endif
-%>
<script
  src="{{ 'overflow-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'quick-add.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{% if settings.show_add_discount_code %}
  <script
    src="{{ 'cart-discount.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- comment -%}
  Solo PDP (y editor): <variant-picker> solo se renderiza en variant-main-picker
  (bloque variant-picker de _product-details) y en el payload de
  section-rendering-product-card. Las tarjetas usan
  swatches-variant-picker-component (product-card.js, global).
{%- endcomment -%}
{% if aunelya_is_product %}
  <script
    src="{{ 'variant-picker.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
<script
  src="{{ 'product-card.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'product-form.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'fly-to-cart.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'accordion-custom.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'media.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'product-price.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- comment -%}
  Solo PDP (y editor): <product-sku-component> y <product-inventory> solo se
  renderizan en los bloques sku / product-inventory de _product-details.
{%- endcomment -%}
{% if aunelya_is_product %}
  <script
    src="{{ 'product-sku.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'product-inventory.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{%- comment -%}
  Solo coleccion/busqueda (y editor): <show-more-component> solo aparece en
  list-filter (facetas).
{%- endcomment -%}
{% if aunelya_is_collection_search %}
  <script
    src="{{ 'show-more.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
<script
  src="{{ 'slideshow.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'layered-slideshow.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'anchored-popover.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- comment -%}
  Solo coleccion/busqueda (y editor): <floating-panel-component> solo aparece en
  list-filter, price-filter, sorting y product-grid (facetas).
{%- endcomment -%}
{% if aunelya_is_collection_search %}
  <script
    src="{{ 'floating-panel.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
<script
  src="{{ 'video-background.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- comment -%}
  PDP + carrito + paginas (y editor): quantity-selector-component se usa en la
  PDP, el carrito, quick-order-list y cart-products. Se incluye 'page' porque
  quick-order-list vive en plantillas page (ver sections/quick-order-list.liquid:151).
{%- endcomment -%}
{% if aunelya_is_product or aunelya_is_cart %}
  <script
    src="{{ 'component-quantity-selector.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{%- comment -%}
  Solo PDP (y editor): <media-gallery> solo se renderiza en
  product-media-gallery-content via _product-media-gallery.
{%- endcomment -%}
{% if aunelya_is_product %}
  <script
    src="{{ 'media-gallery.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
<script
  src="{{ 'rte-formatter.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- comment -%}
  Solo PDP (y editor): <volume-pricing> solo se renderiza en buy-buttons.
{%- endcomment -%}
{% if aunelya_is_product %}
  <script
    src="{{ 'volume-pricing.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{%- comment -%}
  PDP + carrito + paginas (y editor): <price-per-item> vive en quantity-selector y
  <volume-pricing-info> en cart-products / quick-order-list (con volumen en PDP).
{%- endcomment -%}
{% if aunelya_is_product or aunelya_is_cart %}
  <script
    src="{{ 'price-per-item.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'volume-pricing-info.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
  <script
    src="{{ 'localization.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% if template == 'product' or template.name == 'product' or request.page_type == 'product' %}
  <script
    src="{{ 'sticky-add-to-cart.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script type="module">
    import { RecentlyViewed } from '@theme/recently-viewed-products';
    RecentlyViewed.addProduct('{{ product.id }}');
  </script>
{% endif %}

<script
  src="{{ 'auto-close-details.js' | asset_url }}"
  defer="defer"
></script>

<script>
  const supportsNativePopover = 'popover' in HTMLElement.prototype;
  const Theme = {
    supportsNativePopover,
    popoverPolyfillReady: supportsNativePopover
      ? Promise.resolve()
      : import("{{ 'popover-polyfill.js' | asset_url }}").then(() => {}),
    translations: {
      placeholder_image: `{{ 'content.placeholder_image' | t }}`,
      added: `{{ 'actions.added' | t }}`,
      recipient_form_fields_visible: `{{ 'content.recipient_form_fields_visible' | t }}`,
      recipient_form_fields_hidden: `{{ 'content.recipient_form_fields_hidden' | t }}`,
      recipient_form_error: `{{ 'content.recipient_form_error' | t }}`,
      items_added_to_cart_one: `{{ 'content.items_added_to_cart.one' | t }}`,
      items_added_to_cart_other: `{{ 'content.items_added_to_cart.other' | t }}`,
      cart_count: `{{ 'accessibility.cart_count' | t }}`,
    },
    routes: {
      cart_add_url: '{{ routes.cart_add_url | append: '.js' }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}',
      predictive_search_url: '{{ routes.predictive_search_url }}',
      search_url: '{{ routes.search_url }}',
    },
    template: {
      name: '{{ template }}',
    },
  };
</script>
