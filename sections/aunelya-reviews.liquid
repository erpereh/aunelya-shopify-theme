{% if section.settings.enabled and section.blocks.size > 0 %}
  <section id="aunelya-reviews" class="aunelya-home-section aunelya-reviews aunelya-section-space" aria-labelledby="AunelyaReviews-{{ section.id }}">
    <div class="aunelya-shell">
      <h2 id="AunelyaReviews-{{ section.id }}" class="aunelya-section-heading">{{ section.settings.heading }}</h2>
      <div class="aunelya-reviews__grid">
        {% for block in section.blocks %}
          {% if block.settings.quote != blank and block.settings.author != blank %}
            <article class="aunelya-review" {{ block.shopify_attributes }}>
              {% if block.settings.show_rating %}
                <div class="aunelya-review__rating" aria-label="{{ block.settings.rating }} de 5 estrellas">
                  {% for index in (1..block.settings.rating) %}
                    {% render 'aunelya-icon', icon: 'star' %}
                  {% endfor %}
                </div>
              {% endif %}
              <blockquote>{{ block.settings.quote }}</blockquote>
              <cite>
                {{ block.settings.author }}
                {% if block.settings.context != blank %}<span> · {{ block.settings.context }}</span>{% endif %}
              </cite>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Aunelya opiniones",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Mostrar sección", "default": false },
    { "type": "text", "id": "heading", "label": "Título", "default": "Opiniones" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Opinión real",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Testimonio" },
        { "type": "text", "id": "author", "label": "Nombre" },
        { "type": "text", "id": "context", "label": "Contexto opcional" },
        { "type": "checkbox", "id": "show_rating", "label": "Mostrar valoración", "default": false },
        { "type": "range", "id": "rating", "label": "Valoración", "min": 1, "max": 5, "step": 1, "default": 5, "visible_if": "{{ block.settings.show_rating }}" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aunelya opiniones"
    }
  ]
}
{% endschema %}
