{% liquid
  assign featured_product = section.settings.product
  assign social_names = 'Instagram,TikTok,Facebook,YouTube' | split: ','
  assign social_keys = 'instagram_url,tiktok_url,facebook_url,youtube_url' | split: ','
%}

<div class="aunelya-footer">
  <div class="aunelya-footer__inner">
    <div class="aunelya-footer__top">
      <div class="aunelya-footer__brand">
        <a class="aunelya-footer__wordmark" href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: height: 64 | image_tag: height: 32, alt: shop.name, class: 'aunelya-footer__logo' }}
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>
        {% if section.settings.tagline != blank %}
          <p class="aunelya-footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}
      </div>

      {% if featured_product != blank and section.settings.cta_label != blank %}
        <a class="aunelya-footer__cta" href="{{ featured_product.url }}">
          <span class="aunelya-footer__cta-label">{{ section.settings.cta_label }}</span>
          <span class="aunelya-footer__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <nav class="aunelya-footer__nav" aria-label="{{ section.settings.nav_label | escape }}">
        {% for block in section.blocks %}
          {% capture column_links %}
            {%- case block.type -%}
              {%- when 'product' -%}
                {%- if featured_product != blank -%}
                  <li><a class="aunelya-footer__link" href="{{ featured_product.url }}">{{ featured_product.title }}</a></li>
                  {%- unless featured_product.has_only_default_variant -%}
                    {%- for variant in featured_product.variants -%}
                      <li><a class="aunelya-footer__link" href="{{ variant.url }}">{{ variant.title }}</a></li>
                    {%- endfor -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- when 'links' -%}
                {%- for i in (1..5) -%}
                  {%- assign label_key = 'label_' | append: i -%}
                  {%- assign link_key = 'link_' | append: i -%}
                  {%- if block.settings[label_key] != blank and block.settings[link_key] != blank -%}
                    <li><a class="aunelya-footer__link" href="{{ block.settings[link_key] }}">{{ block.settings[label_key] }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- when 'account' -%}
                {%- if shop.customer_accounts_enabled and block.settings.account_label != blank -%}
                  <li><a class="aunelya-footer__link" href="{{ routes.account_url }}">{{ block.settings.account_label }}</a></li>
                {%- endif -%}
                {%- if block.settings.cart_label != blank -%}
                  <li><a class="aunelya-footer__link" href="{{ routes.cart_url }}">{{ block.settings.cart_label }}</a></li>
                {%- endif -%}
              {%- when 'policies' -%}
                {%- for policy in shop.policies -%}
                  {%- if policy.body != blank -%}
                    <li><a class="aunelya-footer__link" href="{{ policy.url }}">{{ policy.title }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
            {%- endcase -%}
          {% endcapture %}
          {% assign column_links = column_links | strip %}

          {% if column_links != blank %}
            <div class="aunelya-footer__column" {{ block.shopify_attributes }}>
              <h2 class="aunelya-footer__heading">{{ block.settings.heading }}</h2>
              <ul class="aunelya-footer__list" role="list">
                {{ column_links }}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    <div class="aunelya-footer__bottom">
      <p class="aunelya-footer__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
      </p>

      {% capture social_links %}
        {%- for key in social_keys -%}
          {%- if section.settings[key] != blank -%}
            <li><a class="aunelya-footer__link" href="{{ section.settings[key] }}" target="_blank" rel="noopener">{{ social_names[forloop.index0] }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      {% endcapture %}
      {% assign social_links = social_links | strip %}
      {% if social_links != blank %}
        <ul class="aunelya-footer__social" role="list" aria-label="Redes sociales">
          {{ social_links }}
        </ul>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Aunelya footer",
  "tag": "section",
  "class": "aunelya-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "tagline", "label": "Frase de marca", "default": "Comodidad que se adapta a ti." },
    { "type": "product", "id": "product", "label": "Producto principal" },
    { "type": "text", "id": "cta_label", "label": "Texto del enlace principal", "default": "Comprar ahora" },
    { "type": "text", "id": "nav_label", "label": "Etiqueta accesible de la navegación", "default": "Pie de página" },
    { "type": "header", "content": "Redes sociales" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "product",
      "name": "Columna de producto",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Producto" }
      ]
    },
    {
      "type": "links",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Ayuda" },
        { "type": "text", "id": "label_1", "label": "Texto 1" },
        { "type": "url", "id": "link_1", "label": "Enlace 1" },
        { "type": "text", "id": "label_2", "label": "Texto 2" },
        { "type": "url", "id": "link_2", "label": "Enlace 2" },
        { "type": "text", "id": "label_3", "label": "Texto 3" },
        { "type": "url", "id": "link_3", "label": "Enlace 3" },
        { "type": "text", "id": "label_4", "label": "Texto 4" },
        { "type": "url", "id": "link_4", "label": "Enlace 4" },
        { "type": "text", "id": "label_5", "label": "Texto 5" },
        { "type": "url", "id": "link_5", "label": "Enlace 5" }
      ]
    },
    {
      "type": "account",
      "name": "Columna de cuenta",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Tu cuenta" },
        { "type": "text", "id": "account_label", "label": "Texto de cuenta", "default": "Mi cuenta" },
        { "type": "text", "id": "cart_label", "label": "Texto de carrito", "default": "Carrito" }
      ]
    },
    {
      "type": "policies",
      "name": "Columna legal",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Legal" },
        { "type": "paragraph", "content": "Muestra automáticamente las políticas publicadas en Configuración > Políticas." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aunelya footer",
      "blocks": [
        { "type": "product" },
        { "type": "links" },
        { "type": "account" },
        { "type": "policies" }
      ]
    }
  ]
}
{% endschema %}
