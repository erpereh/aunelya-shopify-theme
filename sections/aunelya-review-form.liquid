{% liquid
  assign form_id = 'AunelyaReviewForm-' | append: section.id
  assign anchor_id = 'aunelya-review-form'
  if section.settings.anchor_id != blank
    assign anchor_id = section.settings.anchor_id
  endif
%}

<section
  id="{{ anchor_id }}"
  class="aunelya-home-section aunelya-review-form aunelya-section-space"
  aria-labelledby="AunelyaReviewFormTitle-{{ section.id }}"
>
  <div class="aunelya-shell aunelya-review-form__layout">
    <header class="aunelya-review-form__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="aunelya-reviews-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 id="AunelyaReviewFormTitle-{{ section.id }}" class="aunelya-section-heading">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="aunelya-section-copy">{{ section.settings.subheading }}</p>
      {% endif %}
      <ol class="aunelya-review-form__steps" role="list">
        <li><span aria-hidden="true">1.</span> {{ section.settings.step_1 }}</li>
        <li><span aria-hidden="true">2.</span> {{ section.settings.step_2 }}</li>
        <li><span aria-hidden="true">3.</span> {{ section.settings.step_3 }}</li>
      </ol>
    </header>

    <div class="aunelya-review-form__panel">
      {%- form 'contact', id: form_id, class: 'aunelya-review-form__form', novalidate: 'novalidate' -%}
        {% liquid
          assign form_matches = false
          if form.id == form_id or form.id == blank
            assign form_matches = true
          endif
          assign product_title = product.title | default: section.settings.product_fallback
        %}
        <input type="hidden" name="contact[tags]" value="resena-pendiente">
        <input type="hidden" name="contact[Producto]" value="{{ product_title | escape }}">

        {%- if form.posted_successfully? and form_matches -%}
          <div class="aunelya-review-form__success" role="status" tabindex="-1" autofocus>
            <span class="aunelya-review-form__success-mark" aria-hidden="true">✓</span>
            <h3 class="aunelya-review-form__panel-title">{{ section.settings.success_heading }}</h3>
            <p class="aunelya-review-form__panel-text">{{ section.settings.success_message }}</p>
          </div>
        {%- else -%}
          {%- if form.errors and form_matches -%}
            <p class="aunelya-review-form__alert" role="alert" tabindex="-1" autofocus>
              {{ section.settings.error_message }}
            </p>
          {%- endif -%}

          <fieldset class="aunelya-review-form__rating">
            <legend>{{ section.settings.rating_label }} <span aria-hidden="true">*</span></legend>
            <div class="aunelya-review-form__stars" role="radiogroup" aria-label="{{ section.settings.rating_label }}">
              {% for i in (5..1) %}
                <span class="aunelya-review-form__star">
                  <input
                    type="radio"
                    id="{{ form_id }}-rating-{{ i }}"
                    name="contact[Valoración]"
                    value="{{ i }}"
                    {% if forloop.first %}checked{% endif %}
                    required
                  >
                  <label for="{{ form_id }}-rating-{{ i }}" title="{{ i }} de 5">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3L12 17.1l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z"/></svg>
                    <span class="visually-hidden">{{ i }} de 5</span>
                  </label>
                </span>
              {% endfor %}
            </div>
          </fieldset>

          <div class="aunelya-review-form__fields">
            <div class="aunelya-field">
              <textarea
                class="aunelya-field__input aunelya-field__input--textarea"
                id="{{ form_id }}-body"
                name="contact[Opinión]"
                rows="4"
                placeholder=" "
                required
                aria-required="true"
                {% if form.errors contains 'body' and form_matches %}aria-invalid="true"{% endif %}
              >{{- form.body -}}</textarea>
              <label class="aunelya-field__label" for="{{ form_id }}-body">{{ section.settings.message_label }} <span aria-hidden="true">*</span></label>
            </div>

            <div class="aunelya-review-form__row">
              <div class="aunelya-field">
                <input
                  class="aunelya-field__input"
                  type="text"
                  id="{{ form_id }}-name"
                  name="contact[name]"
                  autocomplete="name"
                  placeholder=" "
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                >
                <label class="aunelya-field__label" for="{{ form_id }}-name">{{ section.settings.name_label }}</label>
              </div>

              <div class="aunelya-field">
                <input
                  class="aunelya-field__input"
                  type="email"
                  id="{{ form_id }}-email"
                  name="contact[email]"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  placeholder=" "
                  required
                  aria-required="true"
                  {% if form.errors contains 'email' and form_matches %}
                    aria-invalid="true"
                    aria-describedby="{{ form_id }}-email-error"
                  {% endif %}
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                >
                <label class="aunelya-field__label" for="{{ form_id }}-email">{{ section.settings.email_label }} <span aria-hidden="true">*</span></label>
                {% if form.errors contains 'email' and form_matches %}
                  <p class="aunelya-field__error" id="{{ form_id }}-email-error">
                    {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                  </p>
                {% endif %}
              </div>
            </div>

            <div class="aunelya-field">
              <input
                class="aunelya-field__input"
                type="text"
                id="{{ form_id }}-title"
                name="contact[Titular]"
                placeholder=" "
                maxlength="80"
              >
              <label class="aunelya-field__label" for="{{ form_id }}-title">{{ section.settings.title_label }}</label>
            </div>
          </div>

          <label class="aunelya-review-form__consent">
            <input type="checkbox" name="contact[Consentimiento]" value="Acepto publicación anónima" required>
            <span>{{ section.settings.consent_label }}</span>
          </label>

          <div class="aunelya-contact__actions">
            <button type="submit" class="aunelya-button aunelya-contact__submit">
              <span class="aunelya-contact__submit-label">{{ section.settings.submit_label }}</span>
              <span class="aunelya-contact__submit-arrow" aria-hidden="true">&rarr;</span>
              <span class="aunelya-contact__spinner" aria-hidden="true"></span>
            </button>
            {% if section.settings.note != blank %}
              <p class="aunelya-contact__note">{{ section.settings.note }}</p>
            {% endif %}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.getElementById('{{ form_id }}');
    if (!form) return;
    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        form.classList.add('is-validated');
        form.querySelector(':invalid')?.focus();
        return;
      }
      const button = form.querySelector('[type="submit"]');
      if (button?.getAttribute('aria-busy') === 'true') {
        event.preventDefault();
        return;
      }
      button?.setAttribute('aria-busy', 'true');
    });
  })();
</script>

{% schema %}
{
  "name": "Aunelya dejar reseña",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "ID del ancla", "default": "aunelya-review-form" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Tu opinión" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Comparte tu experiencia" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Cuéntanos cómo te acompaña tu Aunelya. La publicamos de forma anónima tras revisarla." },
    { "type": "text", "id": "step_1", "label": "Paso 1", "default": "Escríbela aquí, tarda 1 minuto." },
    { "type": "text", "id": "step_2", "label": "Paso 2", "default": "La revisamos para evitar spam." },
    { "type": "text", "id": "step_3", "label": "Paso 3", "default": "La publicamos como Anónimo." },
    { "type": "text", "id": "product_fallback", "label": "Producto (si no se detecta)", "default": "Cinturón térmico Aunelya" },
    { "type": "text", "id": "rating_label", "label": "Etiqueta valoración", "default": "Tu puntuación" },
    { "type": "text", "id": "message_label", "label": "Etiqueta opinión", "default": "Tu opinión" },
    { "type": "text", "id": "name_label", "label": "Etiqueta nombre", "default": "Nombre (opcional, no se publica)" },
    { "type": "text", "id": "email_label", "label": "Etiqueta email", "default": "Email (solo para verificar)" },
    { "type": "text", "id": "title_label", "label": "Etiqueta titular", "default": "Titular (opcional)" },
    { "type": "textarea", "id": "consent_label", "label": "Consentimiento", "default": "Acepto que mi opinión se publique de forma anónima." },
    { "type": "text", "id": "submit_label", "label": "Botón", "default": "Enviar mi reseña" },
    { "type": "text", "id": "note", "label": "Nota bajo el botón", "default": "No publicamos tu nombre ni tu email. Solo usamos tu email para verificar." },
    { "type": "text", "id": "error_message", "label": "Error", "default": "No hemos podido enviar tu reseña. Revisa los campos marcados." },
    { "type": "text", "id": "success_heading", "label": "Éxito título", "default": "¡Gracias por tu reseña!" },
    { "type": "textarea", "id": "success_message", "label": "Éxito mensaje", "default": "La hemos recibido y la publicaremos como Anónimo tras revisarla." }
  ],
  "presets": [{ "name": "Aunelya dejar reseña" }]
}
{% endschema %}
