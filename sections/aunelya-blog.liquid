<section class="aunelya-home-section aunelya-section-space" aria-labelledby="AunelyaBlog-{{ section.id }}">
  <div class="aunelya-shell">
    <header>
      <h1 id="AunelyaBlog-{{ section.id }}" class="aunelya-section-heading">{{ section.settings.heading | default: blog.title }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="aunelya-section-copy">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    {% paginate blog.articles by 12 %}
      {% if blog.articles.size > 0 %}
        <div class="aunelya-blog-grid">
          {% for article in blog.articles %}
            <a class="aunelya-card-link aunelya-blog-card" href="{{ article.url }}">
              <span class="aunelya-blog-card__media">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 640 }}"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="lazy"
                    width="640"
                    height="480"
                  >
                {% endif %}
              </span>
              <span class="aunelya-blog-card__meta">{{ article.published_at | date: '%d %b %Y' }}</span>
              <h2 class="aunelya-blog-card__title">{{ article.title }}</h2>
              {% if article.excerpt != blank %}
                <p class="aunelya-blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {% else %}
                <p class="aunelya-blog-card__excerpt">{{ article.content | strip_html | truncate: 120 }}</p>
              {% endif %}
            </a>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="aunelya-pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% else %}
        <p class="aunelya-blog-empty">{{ section.settings.empty_text }}</p>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Aunelya blog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "info": "Déjalo vacío para usar el nombre del blog." },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "text", "id": "empty_text", "label": "Texto sin artículos", "default": "Todavía no hay artículos publicados." }
  ],
  "presets": [
    { "name": "Aunelya blog" }
  ]
}
{% endschema %}
