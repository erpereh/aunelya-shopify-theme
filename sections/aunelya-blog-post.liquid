<section class="aunelya-home-section aunelya-section-space" aria-labelledby="AunelyaArticle-{{ section.id }}">
  <div class="aunelya-shell aunelya-article__layout">
    <a class="aunelya-article__back" href="{{ blog.url }}">
      <span aria-hidden="true">&larr;</span>
      <span>{{ section.settings.back_label }}</span>
    </a>

    <header class="aunelya-article__header">
      <p class="aunelya-article__eyebrow">{{ blog.title }}</p>
      <h1 id="AunelyaArticle-{{ section.id }}" class="aunelya-article__title">{{ article.title }}</h1>
      <p class="aunelya-article__meta">
        {{ article.published_at | date: '%d de %B de %Y' }}
        {% if article.author != blank %} · {{ article.author }}{% endif %}
      </p>
    </header>

    {% if article.image %}
      <div class="aunelya-article__image">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          loading="eager"
          width="1200"
          height="900"
        >
      </div>
    {% endif %}

    <div class="aunelya-article__content">
      {{ article.content }}
    </div>

    {% assign related_count = 0 %}
    {% capture related_links %}
      {% for other in blog.articles %}
        {% if other.id != article.id and related_count < 3 %}
          {% assign related_count = related_count | plus: 1 %}
          <a class="aunelya-article__more-link" href="{{ other.url }}">{{ other.title }}</a>
        {% endif %}
      {% endfor %}
    {% endcapture %}
    {% if related_count > 0 %}
      <div class="aunelya-article__more">
        <h2 class="aunelya-article__more-heading">{{ section.settings.more_heading }}</h2>
        <div class="aunelya-article__more-list">
          {{ related_links }}
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_cta %}
      <div class="aunelya-article__cta">
        <p>{{ section.settings.cta_text }}</p>
        <a class="aunelya-article__cta-link" href="{{ section.settings.cta_url }}">
          <span>{{ section.settings.cta_label }}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Aunelya artículo",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Texto del enlace de vuelta", "default": "Volver al blog" },
    { "type": "text", "id": "more_heading", "label": "Título de artículos relacionados", "default": "Más artículos" },
    { "type": "checkbox", "id": "show_cta", "label": "Mostrar CTA al producto", "default": true },
    { "type": "text", "id": "cta_text", "label": "Texto del CTA", "default": "¿Listo para probarlo?" },
    { "type": "url", "id": "cta_url", "label": "Enlace del CTA" },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Ver el cinturón térmico Aunelya" }
  ],
  "presets": [
    { "name": "Aunelya artículo" }
  ]
}
{% endschema %}
