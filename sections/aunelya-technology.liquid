<section id="aunelya-technology" class="aunelya-home-section aunelya-technology aunelya-section-space" aria-labelledby="AunelyaTechnology-{{ section.id }}">
  <div class="aunelya-shell">
    <div class="aunelya-technology__panel">
      <div class="aunelya-technology__media">
        {% render 'aunelya-image',
          image: section.settings.image,
          asset_name: 'aunelya-product-white-kit-alt.webp',
          alt: section.settings.image_alt,
          class: 'aunelya-technology__image',
          width: 1448,
          height: 1086,
          sizes: '(min-width: 1100px) 56vw, 100vw'
        %}
      </div>
      <div class="aunelya-technology__content">
        <h2 id="AunelyaTechnology-{{ section.id }}" class="aunelya-section-heading">{{ section.settings.heading }}</h2>
        <ul class="aunelya-technology__features" role="list">
          {% for block in section.blocks %}
            <li class="aunelya-feature" {{ block.shopify_attributes }}>
              {% render 'aunelya-icon', icon: block.settings.icon %}
              <span>{{ block.settings.label }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aunelya tecnología",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Tecnología pensada para tu comodidad" },
    { "type": "image_picker", "id": "image", "label": "Imagen alternativa" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo", "default": "Detalle del cinturón térmico portátil Aunelya" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "feature",
      "name": "Prestación",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "heat", "label": "Calor" },
            { "value": "vibration", "label": "Vibración" },
            { "value": "portable", "label": "Portátil" },
            { "value": "adjustable", "label": "Ajustable" }
          ],
          "default": "heat"
        },
        { "type": "text", "id": "label", "label": "Texto", "default": "5 niveles de calor" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aunelya tecnología",
      "blocks": [
        { "type": "feature", "settings": { "icon": "heat", "label": "5 niveles de calor" } },
        { "type": "feature", "settings": { "icon": "vibration", "label": "4 niveles de vibración" } },
        { "type": "feature", "settings": { "icon": "portable", "label": "Portátil" } },
        { "type": "feature", "settings": { "icon": "adjustable", "label": "Correa ajustable" } }
      ]
    }
  ]
}
{% endschema %}
