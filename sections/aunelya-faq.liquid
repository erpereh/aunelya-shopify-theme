<section class="aunelya-home-section aunelya-pdp-faq aunelya-section-space" aria-labelledby="AunelyaFaq-{{ section.id }}">
  <div class="aunelya-shell aunelya-pdp-faq__layout">
    <header class="aunelya-pdp-faq__header">
      {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
      <{{ heading_tag }} id="AunelyaFaq-{{ section.id }}" class="aunelya-section-heading">{{ section.settings.heading }}</{{ heading_tag }}>
      {% if section.settings.subheading != blank %}
        <p class="aunelya-section-copy">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <div class="aunelya-pdp-faq__list">
      {% for block in section.blocks %}
        {% liquid
          assign policy = blank
          case block.settings.policy_link
            when 'refund'
              assign policy = shop.refund_policy
            when 'shipping'
              assign policy = shop.shipping_policy
          endcase
        %}
        <details class="aunelya-faq-item" {{ block.shopify_attributes }}>
          <summary class="aunelya-faq-item__question">
            <span>{{ block.settings.question }}</span>
            <span class="aunelya-faq-item__toggle" aria-hidden="true"></span>
          </summary>
          <div class="aunelya-faq-item__answer">
            {{ block.settings.answer }}
            {% if policy != blank %}
              <p>
                <a class="aunelya-faq-item__link" href="{{ policy.url }}">{{ policy.title }} <span aria-hidden="true">&rarr;</span></a>
              </p>
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% render 'aunelya-faq-schema', blocks: section.blocks %}

{% schema %}
{
  "name": "Aunelya preguntas",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Nivel del título",
      "info": "Usa H1 cuando la sección sea el contenido principal de la página.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cómo se usa?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Consulta el manual incluido antes del primer uso.</p>" },
        {
          "type": "select",
          "id": "policy_link",
          "label": "Enlace a política",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "refund", "label": "Política de reembolso" },
            { "value": "shipping", "label": "Política de envío" }
          ],
          "default": "none",
          "info": "Se muestra sólo si la política está publicada en Shopify Admin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aunelya preguntas",
      "blocks": [
        { "type": "question", "settings": { "question": "¿Cómo se usa?", "answer": "<p>Colócalo alrededor de la zona donde quieras sentir calor, ajusta la correa a tu medida y elige el nivel que te resulte cómodo. Consulta el manual incluido antes del primer uso.</p>" } },
        { "type": "question", "settings": { "question": "¿Qué devoluciones aceptan?", "answer": "<p>Revisa nuestra política de reembolso para conocer las condiciones.</p>", "policy_link": "refund" } }
      ]
    }
  ]
}
{% endschema %}
