{% doc %}
  Renders the product's real rating summary plus the connected review app's blocks.

  The section is hidden until the product has at least one real review
  (product.metafields.reviews.rating_count > 0). Individual reviews,
  the submission form and review structured data belong to the review
  app, never to this theme.
{% enddoc %}

{% liquid
  assign rating_value = 0
  assign rating_count = 0

  # Standard review metafields, written by Shopify-compatible review apps.
  assign rating_metafield = product.metafields.reviews.rating.value
  assign count_metafield = product.metafields.reviews.rating_count.value

  if rating_metafield != blank and count_metafield != blank
    if count_metafield > 0
      assign scale_max = rating_metafield.scale_max | default: 5 | times: 1.0
      assign rating_value = rating_metafield.rating | times: 1.0 | divided_by: scale_max | times: 5
      assign rating_count = count_metafield
    endif
  endif

  assign has_app_blocks = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app_blocks = true
    endif
  endfor

  assign score = rating_value | round: 1 | append: '' | replace: '.', ','
  unless score contains ','
    assign score = score | append: ',0'
  endunless
  assign score_label = score | append: ' de 5'
%}

{% if rating_count > 0 %}
  <section
    class="aunelya-home-section aunelya-reviews-pdp aunelya-section-space"
    aria-labelledby="AunelyaReviewsTitle-{{ section.id }}"
  >
    <div class="aunelya-shell aunelya-reviews-pdp__layout">
      <header class="aunelya-reviews-pdp__summary">
        {% if section.settings.eyebrow != blank %}
          <p class="aunelya-reviews-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="AunelyaReviewsTitle-{{ section.id }}" class="aunelya-section-heading">{{ section.settings.heading }}</h2>

        <div class="aunelya-reviews-pdp__score">
          <span class="aunelya-reviews-pdp__score-value">{{ score }}</span>
          <div>
            {% render 'aunelya-stars', rating: rating_value, class: 'aunelya-stars--large', label: score_label %}
            <p class="aunelya-reviews-pdp__score-count">
              {{ section.settings.count_prefix }}
              {{ rating_count }}
              {% if rating_count == 1 %}{{ section.settings.count_singular }}{% else %}{{ section.settings.count_plural }}{% endif %}
            </p>
          </div>
        </div>
      </header>

      {% if has_app_blocks %}
        <div class="aunelya-reviews-pdp__list" role="list">
          {% for block in section.blocks %}
            {% if block.type == '@app' %}
              <div class="aunelya-reviews-pdp__app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Aunelya valoraciones",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Valoraciones" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dicen quienes ya lo usan" },
    {
      "type": "paragraph",
      "content": "La sección solo aparece cuando hay al menos una reseña real. La puntuación se lee de los metacampos estándar (reviews.rating y reviews.rating_count) que escribe tu app de valoraciones. Añade el bloque de tu app (Judge.me, Loox…) para mostrar las opiniones, el formulario y gestionar las reseñas."
    },
    { "type": "text", "id": "count_prefix", "label": "Texto antes del número", "default": "Basado en" },
    { "type": "text", "id": "count_singular", "label": "Valoración (singular)", "default": "valoración" },
    { "type": "text", "id": "count_plural", "label": "Valoraciones (plural)", "default": "valoraciones" }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Aunelya valoraciones" }
  ]
}
{% endschema %}
