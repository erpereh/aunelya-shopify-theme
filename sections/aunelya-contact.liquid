{% liquid
  assign form_id = 'AunelyaContact-' | append: section.id
  assign panel_id = 'AunelyaContactForm-' | append: section.id

  assign social_names = 'Instagram,TikTok,Facebook,YouTube' | split: ','
  assign social_keys = 'instagram_url,tiktok_url,facebook_url,youtube_url' | split: ','
  assign has_social = false
  for key in social_keys
    if section.settings[key] != blank
      assign has_social = true
    endif
  endfor

  assign has_details = false
  if section.settings.email != blank or section.settings.phone != blank or section.settings.location != blank or section.settings.hours != blank or has_social
    assign has_details = true
  endif
%}

<section class="aunelya-home-section aunelya-contact" aria-labelledby="AunelyaContactTitle-{{ section.id }}">
  <div class="aunelya-shell">
    <header class="aunelya-contact__hero">
      <div class="aunelya-contact__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="aunelya-contact__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 id="AunelyaContactTitle-{{ section.id }}" class="aunelya-contact__title">{{ section.settings.heading }}</h1>
        {% if section.settings.subheading != blank %}
          <p class="aunelya-contact__lead">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.jump_label != blank %}
          <a class="aunelya-contact__jump" href="#{{ panel_id }}">
            <span>{{ section.settings.jump_label }}</span>
            <span class="aunelya-contact__jump-arrow" aria-hidden="true">&darr;</span>
          </a>
        {% endif %}
      </div>

      <figure class="aunelya-contact__hero-media">
        {% render 'aunelya-image',
          image: section.settings.hero_image,
          asset_name: 'aunelya-lifestyle-home.webp',
          alt: section.settings.hero_image_alt,
          class: 'aunelya-contact__hero-image',
          width: 1448,
          height: 1086,
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'eager',
          fetchpriority: 'high'
        %}
        {% if section.settings.hero_caption != blank %}
          <figcaption class="aunelya-contact__caption">
            <span class="aunelya-contact__caption-dot" aria-hidden="true"></span>
            {{ section.settings.hero_caption }}
          </figcaption>
        {% endif %}
      </figure>
    </header>

    <div class="aunelya-contact__body">
      <div class="aunelya-contact__aside">
        {% if has_details %}
          <div class="aunelya-contact__group">
            {% if section.settings.details_heading != blank %}
              <h2 class="aunelya-contact__subtitle">{{ section.settings.details_heading }}</h2>
            {% endif %}
            <dl class="aunelya-contact__details">
              {% if section.settings.email != blank %}
                <div class="aunelya-contact__detail">
                  <dt>{{ section.settings.email_label }}</dt>
                  <dd><a href="mailto:{{ section.settings.email | strip }}">{{ section.settings.email }}</a></dd>
                </div>
              {% endif %}
              {% if section.settings.phone != blank %}
                <div class="aunelya-contact__detail">
                  <dt>{{ section.settings.phone_label }}</dt>
                  <dd><a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ section.settings.phone }}</a></dd>
                </div>
              {% endif %}
              {% if section.settings.location != blank %}
                <div class="aunelya-contact__detail">
                  <dt>{{ section.settings.location_label }}</dt>
                  <dd>{{ section.settings.location }}</dd>
                </div>
              {% endif %}
              {% if section.settings.hours != blank %}
                <div class="aunelya-contact__detail">
                  <dt>{{ section.settings.hours_label }}</dt>
                  <dd>{{ section.settings.hours }}</dd>
                </div>
              {% endif %}
              {% if has_social %}
                <div class="aunelya-contact__detail">
                  <dt>{{ section.settings.social_label }}</dt>
                  <dd>
                    <ul class="aunelya-contact__social" role="list">
                      {% for key in social_keys %}
                        {% if section.settings[key] != blank %}
                          <li><a href="{{ section.settings[key] }}" target="_blank" rel="noopener">{{ social_names[forloop.index0] }}</a></li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </dd>
                </div>
              {% endif %}
            </dl>
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="aunelya-contact__group">
            {% if section.settings.topics_heading != blank %}
              <h2 class="aunelya-contact__subtitle">{{ section.settings.topics_heading }}</h2>
            {% endif %}
            <ol class="aunelya-contact__topics" role="list">
              {% for block in section.blocks %}
                {% liquid
                  assign topic_link = block.settings.link
                  assign topic_link_label = block.settings.link_label
                  if topic_link == blank
                    assign policy = blank
                    case block.settings.icon
                      when 'returns'
                        assign policy = shop.refund_policy
                      when 'shipping'
                        assign policy = shop.shipping_policy
                    endcase
                    if policy != blank
                      assign topic_link = policy.url
                      assign topic_link_label = policy.title
                    endif
                  endif
                %}
                <li class="aunelya-contact__topic" {{ block.shopify_attributes }}>
                  <span class="aunelya-contact__topic-index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <div>
                    <p class="aunelya-contact__topic-title">{{ block.settings.title }}</p>
                    {% if block.settings.text != blank %}
                      <p class="aunelya-contact__topic-text">{{ block.settings.text }}</p>
                    {% endif %}
                    {% if topic_link != blank and topic_link_label != blank %}
                      <a class="aunelya-contact__topic-link" href="{{ topic_link }}">
                        {{ topic_link_label }} <span aria-hidden="true">&rarr;</span>
                      </a>
                    {% endif %}
                  </div>
                </li>
              {% endfor %}
            </ol>
          </div>
        {% endif %}

        {% if section.settings.show_page_content and page.content != blank %}
          <div class="aunelya-contact__page-content rte">{{ page.content }}</div>
        {% endif %}
      </div>

      <div class="aunelya-contact__panel" id="{{ panel_id }}">
        {%- form 'contact', id: form_id, class: 'aunelya-contact__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="contact[id]" value="{{ form_id }}">

          {% liquid
            assign form_matches = false
            if form.id == form_id or form.id == blank
              assign form_matches = true
            endif
          %}

          {%- if form.posted_successfully? and form_matches -%}
            <div class="aunelya-contact__success" role="status" tabindex="-1" autofocus>
              <span class="aunelya-contact__success-mark" aria-hidden="true"></span>
              <h2 class="aunelya-contact__panel-title">{{ section.settings.success_heading }}</h2>
              <p class="aunelya-contact__panel-text">
                {%- if section.settings.success_message != blank -%}
                  {{ section.settings.success_message }}
                {%- else -%}
                  {{ 'blocks.contact_form.post_success' | t }}
                {%- endif -%}
              </p>
              {% if section.settings.success_link_label != blank %}
                <a class="aunelya-contact__jump" href="{{ routes.root_url }}">
                  <span>{{ section.settings.success_link_label }}</span>
                  <span class="aunelya-contact__jump-arrow aunelya-contact__jump-arrow--side" aria-hidden="true">&rarr;</span>
                </a>
              {% endif %}
            </div>
          {%- else -%}
            <div class="aunelya-contact__panel-header">
              {% if section.settings.form_heading != blank %}
                <h2 class="aunelya-contact__panel-title">{{ section.settings.form_heading }}</h2>
              {% endif %}
              {% if section.settings.form_text != blank %}
                <p class="aunelya-contact__panel-text">{{ section.settings.form_text }}</p>
              {% endif %}
            </div>

            {%- if form.errors and form_matches -%}
              <p class="aunelya-contact__alert" role="alert" tabindex="-1" autofocus>
                {{ section.settings.error_message }}
              </p>
            {%- endif -%}

            <div class="aunelya-contact__fields">
              <div class="aunelya-field">
                <input
                  class="aunelya-field__input"
                  type="text"
                  id="{{ form_id }}-name"
                  name="contact[name]"
                  autocomplete="name"
                  placeholder=" "
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                >
                <label class="aunelya-field__label" for="{{ form_id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
              </div>

              <div class="aunelya-field">
                <input
                  class="aunelya-field__input"
                  type="email"
                  id="{{ form_id }}-email"
                  name="contact[email]"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  placeholder=" "
                  required
                  aria-required="true"
                  {% if form.errors contains 'email' and form_matches %}
                    aria-invalid="true"
                    aria-describedby="{{ form_id }}-email-error"
                  {% endif %}
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                >
                <label class="aunelya-field__label" for="{{ form_id }}-email">
                  {{- 'blocks.contact_form.email' | t }} <span aria-hidden="true">*</span>
                </label>
                {% if form.errors contains 'email' and form_matches %}
                  <p class="aunelya-field__error" id="{{ form_id }}-email-error">
                    {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                  </p>
                {% else %}
                  <p class="aunelya-field__error aunelya-field__error--live">{{ section.settings.email_error }}</p>
                {% endif %}
              </div>

              <div class="aunelya-field">
                <input
                  class="aunelya-field__input"
                  type="tel"
                  id="{{ form_id }}-phone"
                  name="contact[phone]"
                  autocomplete="tel"
                  placeholder=" "
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                >
                <label class="aunelya-field__label" for="{{ form_id }}-phone">
                  {{- 'blocks.contact_form.phone' | t }} <span class="aunelya-field__optional">{{ section.settings.optional_label }}</span>
                </label>
              </div>

              {% if section.settings.topics != blank %}
                {% assign topics = section.settings.topics | newline_to_br | split: '<br />' %}
                <div class="aunelya-field aunelya-field--select">
                  <select class="aunelya-field__input" id="{{ form_id }}-topic" name="contact[{{ section.settings.topic_label | escape }}]">
                    {% for topic in topics %}
                      {% assign topic_value = topic | strip %}
                      {% if topic_value != blank %}
                        <option value="{{ topic_value | escape }}">{{ topic_value }}</option>
                      {% endif %}
                    {% endfor %}
                  </select>
                  <label class="aunelya-field__label" for="{{ form_id }}-topic">{{ section.settings.topic_label }}</label>
                </div>
              {% endif %}

              <div class="aunelya-field aunelya-field--full">
                <textarea
                  class="aunelya-field__input aunelya-field__input--textarea"
                  id="{{ form_id }}-body"
                  name="contact[body]"
                  rows="5"
                  placeholder=" "
                >{{- form.body -}}</textarea>
                <label class="aunelya-field__label" for="{{ form_id }}-body">{{ section.settings.message_label }}</label>
              </div>
            </div>

            <div class="aunelya-contact__actions">
              <button type="submit" class="aunelya-button aunelya-contact__submit">
                <span class="aunelya-contact__submit-label">{{ section.settings.submit_label }}</span>
                <span class="aunelya-contact__submit-arrow" aria-hidden="true">&rarr;</span>
                <span class="aunelya-contact__spinner" aria-hidden="true"></span>
              </button>
              {% if section.settings.note != blank %}
                <p class="aunelya-contact__note">{{ section.settings.note }}</p>
              {% endif %}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.getElementById('{{ form_id }}');
    if (!form) return;

    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        form.classList.add('is-validated');
        form.querySelector(':invalid')?.focus();
        return;
      }

      const button = form.querySelector('[type="submit"]');
      if (button?.getAttribute('aria-busy') === 'true') {
        event.preventDefault();
        return;
      }
      button?.setAttribute('aria-busy', 'true');
    });
  })();
</script>

{% schema %}
{
  "name": "Aunelya contacto",
  "settings": [
    { "type": "header", "content": "Cabecera" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hablemos." },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Cuéntanos qué necesitas sobre tu pedido, el uso de tu cinturón o cualquier duda. Te responderemos por correo." },
    { "type": "text", "id": "jump_label", "label": "Enlace al formulario", "default": "Escribir un mensaje" },
    { "type": "image_picker", "id": "hero_image", "label": "Imagen alternativa" },
    { "type": "text", "id": "hero_image_alt", "label": "Texto alternativo de la imagen", "default": "Mujer descansando con el cinturón térmico Aunelya rosa" },
    { "type": "text", "id": "hero_caption", "label": "Etiqueta sobre la imagen", "default": "Respuesta por correo electrónico" },
    { "type": "checkbox", "id": "show_page_content", "label": "Mostrar el contenido de la página", "default": true },
    { "type": "header", "content": "Datos de contacto", "info": "Cada dato solo se muestra si está relleno." },
    { "type": "text", "id": "details_heading", "label": "Título de los datos", "default": "Otras formas de encontrarnos" },
    { "type": "text", "id": "email_label", "label": "Etiqueta de email", "default": "Email" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "phone_label", "label": "Etiqueta de teléfono", "default": "Teléfono" },
    { "type": "text", "id": "phone", "label": "Teléfono" },
    { "type": "text", "id": "location_label", "label": "Etiqueta de ubicación", "default": "Ubicación" },
    { "type": "text", "id": "location", "label": "Ubicación" },
    { "type": "text", "id": "hours_label", "label": "Etiqueta de horario", "default": "Horario" },
    { "type": "text", "id": "hours", "label": "Horario" },
    { "type": "text", "id": "social_label", "label": "Etiqueta de redes", "default": "Redes" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "text", "id": "topics_heading", "label": "Título de los temas de ayuda", "default": "¿En qué podemos ayudarte?" },
    { "type": "header", "content": "Formulario" },
    { "type": "text", "id": "form_heading", "label": "Título del formulario", "default": "Escríbenos" },
    { "type": "text", "id": "form_text", "label": "Texto del formulario", "default": "Los campos con * son obligatorios." },
    { "type": "text", "id": "topic_label", "label": "Etiqueta del motivo", "default": "Motivo" },
    { "type": "textarea", "id": "topics", "label": "Motivos", "info": "Uno por línea. Déjalo vacío para ocultar el selector.", "default": "Mi pedido\nEnvíos\nUso del producto\nDevoluciones\nOtro" },
    { "type": "text", "id": "optional_label", "label": "Texto de campo opcional", "default": "(opcional)" },
    { "type": "text", "id": "message_label", "label": "Etiqueta del mensaje", "default": "Mensaje" },
    { "type": "text", "id": "submit_label", "label": "Texto del botón", "default": "Enviar mensaje" },
    { "type": "text", "id": "note", "label": "Nota bajo el botón", "default": "Usaremos tus datos sólo para responder a tu mensaje." },
    { "type": "text", "id": "email_error", "label": "Error de email", "default": "Introduce un email válido." },
    { "type": "text", "id": "error_message", "label": "Error al enviar", "default": "No hemos podido enviar tu mensaje. Revisa los campos marcados." },
    { "type": "text", "id": "success_heading", "label": "Título tras enviar", "default": "Mensaje enviado" },
    { "type": "text", "id": "success_message", "label": "Mensaje de envío correcto", "info": "Si se deja vacío se usa el mensaje del tema." },
    { "type": "text", "id": "success_link_label", "label": "Enlace tras enviar", "default": "Volver a la tienda" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "topic",
      "name": "Tema de ayuda",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Tipo",
          "info": "Envío y devoluciones enlazan a su política si no hay enlace.",
          "options": [
            { "value": "shipping", "label": "Envío" },
            { "value": "returns", "label": "Devoluciones" },
            { "value": "secure", "label": "Compra segura" },
            { "value": "support", "label": "Atención" }
          ],
          "default": "support"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Atención al cliente" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aunelya contacto",
      "blocks": [
        { "type": "topic", "settings": { "icon": "shipping", "title": "Pedidos y envíos", "text": "Cuéntanos tu número de pedido para ayudarte más rápido." } },
        { "type": "topic", "settings": { "icon": "returns", "title": "Devoluciones", "text": "Consulta las condiciones en nuestra política de reembolso." } },
        { "type": "topic", "settings": { "icon": "support", "title": "Uso del producto", "text": "Resolvemos tus dudas sobre calor, vibración y carga." } }
      ]
    }
  ]
}
{% endschema %}
